[Unit]
Description=Smart VRAM broker for RTX 2060 SUPER (evict/restore around ComfyUI jobs, TRK-0478)
After=network.target ollama.service comfyui.service
Wants=ollama.service comfyui.service

[Service]
Type=simple
User=scott
ExecStart=/usr/bin/python3 /home/scott/vram-broker/vram_broker.py run --config /home/scott/.cooper/vram-broker/config.json
Restart=on-failure
RestartSec=5
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/scott/.cooper/vram-broker

[Install]
WantedBy=multi-user.target
