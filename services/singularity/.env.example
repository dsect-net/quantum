# ── Social hub (THE SINGULARITY) ─────────────────────────────────────────────
# Universal DSECT org credential. Also the join code for new signups. When set,
# every /api/v1 and /mcp call needs a session/org bearer (or trusted tailnet
# identity). When unset, the service runs OPEN (local development only).
SINGULARITY_ORG_TOKEN=
# 1 = trust tailnet identity headers (Tailscale HTTPS). Default 0.
SINGULARITY_TRUST_IDENTITY=0
# Social database file (created on demand).
DATABASE_PATH=data/singularity.sqlite
# Live Hive memory lookup. Falls back to the vendored snapshot when unset.
HIVE_MEMORY_URL=
HIVE_MEMORY_TOKEN=

# ── Fleet feed surface (apps/universal-hub) ──────────────────────────────────
# Explicit opt-in. Never enable this on a public deployment. When neither this
# nor the full live settings below are present, the fleet surface is DISABLED.
SINGULARITY_DEMO=false
SINGULARITY_DB=data/singularity.db
# Live mode (fail-closed; all three required):
# Absolute path to an existing organization's profile directory JSON (see README).
SINGULARITY_DIRECTORY=
# Inject these server-side; never VITE_* or committed values.
SINGULARITY_PROXY_SECRET=
SINGULARITY_WORKERS={}
QUANTUM_HUB_URL=
QUANTUM_MCP_KEY=

# ── Transport ────────────────────────────────────────────────────────────────
PORT=8795
HOST=127.0.0.1
