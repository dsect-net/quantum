# Singularity service — environment configuration
# Copy to .env (or export in your shell). Secrets never live in code.

# SQLite database file path (parent dirs are created automatically).
# Set to :memory: for throwaway runs and tests.
SINGULARITY_DB=./data/singularity.db

# Port / interface to listen on.
PORT=8792
HOST=0.0.0.0

# ── Auth (docs/MEMORY.md#identity--secrets) ──────────────────────────────────
# Universal DSECT organization credential (same idea as the hub MCP worker key).
# When set, /api/* and /mcp require either:
#   * a session bearer token issued by POST /api/v1/auth/login, or
#   * this org token itself (agents / the universal MCP gateway use this),
#   * a trusted tailnet identity header (SINGULARITY_TRUST_IDENTITY=1).
# When unset, auth is disabled for local dev — the app labels itself demo mode.
SINGULARITY_ORG_TOKEN=

# Comma-separated credential hashes already assigned to seeded users are NOT
# needed here — use per-user credentials (hashed) via the login flow. This
# token, when set, IS the bootstrap credential for every seeded account until
# each user sets their own credential (POST /api/v1/auth/credential).

# Trust Tailscale / reverse-proxy identity headers (X-Tailscale-User-Login /
# X-DSECT-User) as authenticated identity. Enable ONLY behind the tailnet
# proxy that strips client-supplied copies of these headers.
SINGULARITY_TRUST_IDENTITY=0

# Session lifetime in days (default 30).
SINGULARITY_SESSION_DAYS=30

# ── Memory provider (Hive) ──────────────────────────────────────────────────
# Optional live hive-memory base URL (e.g. http://hive-memory:8787). When
# unreachable or unset, the service serves the vendored snapshot seed and
# labels source: "snapshot" honestly. Never fakes live data.
HIVE_MEMORY_URL=

# ── Seeding ─────────────────────────────────────────────────────────────────
# Set to 0 to disable first-boot seed data (users, memories, welcome post).
SINGULARITY_SEED=1

# Who is logged in first (owner account). Email must be @dsect.net.
SINGULARITY_ADMIN_EMAIL=scotty@dsect.net
