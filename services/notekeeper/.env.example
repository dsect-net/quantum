# Database file path (defaults to ./data/notekeeper.db)
NOTEKEEPER_DB=./data/notekeeper.db

# Optional bearer token for authentication (/mcp and /api/*). If unset, auth is disabled for local dev.
NOTEKEEPER_TOKEN=

# Port to listen on (default: 8791)
PORT=8791

# Local Ollama embedding configuration (Step 4)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Embedding background pass interval in ms (default: 60000; set to 0 to disable timer)
NOTEKEEPER_EMBED_INTERVAL_MS=60000
